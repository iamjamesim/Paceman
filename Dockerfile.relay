FROM python:3.12-slim
WORKDIR /app
COPY requirements-push.txt requirements-relay.txt ./
RUN pip install --no-cache-dir -r requirements-relay.txt
COPY service ./service
ENV PYTHONDONTWRITEBYTECODE=1 \
    PACEMAN_APNS_CONFIG=/etc/secrets/apns.json
CMD ["sh", "-c", "exec gunicorn --workers 1 --worker-class gthread --threads 4 --bind 0.0.0.0:${PORT:-8080} service.relay:application"]
