<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>APNSEnvironment</key><string>$(APNS_ENVIRONMENT)</string>
    <key>CFBundleDisplayName</key><string>$(PACEMAN_DISPLAY_NAME)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Paceman</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>4</string>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).activity</string>
        <key>CFBundleURLSchemes</key><array><string>$(PACEMAN_URL_SCHEME)</string></array>
    </dict></array>
    <!-- Explicit matching also registers this type for native Smart Stack launch. -->
    <key>WKSupportsLiveActivityLaunchAttributeTypes</key><array><string>MonitoringActivity</string></array>
    <key>WKApplication</key><true/>
    <key>UIBackgroundModes</key><array><string>remote-notification</string></array>
    <key>WKCompanionAppBundleIdentifier</key><string>$(IOS_COMPANION_BUNDLE_ID)</string>
    <key>WKRunsIndependentlyOfCompanionApp</key><false/>
</dict></plist>
